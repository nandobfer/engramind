{
  "openapi": "3.1.0",
  "info": {
    "title": "Engramind API",
    "description": "Rede de memórias para agentes de IA: memórias duráveis em canais, entregues por REST, MCP e CLI.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "."
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Redireciona para a Swagger UI",
        "description": "Usa redirect relativo para que a Swagger UI funcione atrás de proxy com prefixo.",
        "operationId": "open_swagger_ui",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "description": "Optional UUID correlation identifier. Invalid values are replaced.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect relativo para a Swagger UI",
            "headers": {
              "location": {
                "schema": {
                  "type": "string"
                },
                "description": "`docs/`, relativo, preservando qualquer prefixo público"
              },
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "UUID correlation identifier used by this request."
              }
            }
          },
          "504": {
            "description": "Tempo limite da requisição",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "UUID correlation identifier used by this request."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/docs": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Abre a Swagger UI",
        "description": "Redireciona para `docs/`; a Swagger UI carrega `../openapi.json`.",
        "operationId": "get_swagger_ui",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "description": "Optional UUID correlation identifier. Invalid values are replaced.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect relativo para o índice da Swagger UI",
            "headers": {
              "location": {
                "schema": {
                  "type": "string"
                },
                "description": "`docs/`, relativo, preservando qualquer prefixo público"
              },
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "UUID correlation identifier used by this request."
              }
            }
          },
          "504": {
            "description": "Tempo limite da requisição",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "UUID correlation identifier used by this request."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Confere se o processo está vivo",
        "description": "Responde sem tocar no banco. Usado pelo `HEALTHCHECK` da imagem.",
        "operationId": "health_live",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "description": "Optional UUID correlation identifier. Invalid values are replaced.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Processo vivo",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "UUID correlation identifier used by this request."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            }
          },
          "504": {
            "description": "Tempo limite da requisição",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "UUID correlation identifier used by this request."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Confere se o serviço pode receber tráfego",
        "description": "Confere o acesso ao banco e se todas as migrações embutidas foram aplicadas, sem expor a configuração.",
        "operationId": "health_ready",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "description": "Optional UUID correlation identifier. Invalid values are replaced.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Serviço pronto",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "UUID correlation identifier used by this request."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "`DATABASE_UNAVAILABLE` ou `MIGRATIONS_PENDING`",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "UUID correlation identifier used by this request."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Tempo limite da requisição",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "UUID correlation identifier used by this request."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Devolve o documento OpenAPI da versão em execução",
        "operationId": "get_openapi_document",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "description": "Optional UUID correlation identifier. Invalid values are replaced.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Documento OpenAPI em JSON",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "UUID correlation identifier used by this request."
              }
            },
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "504": {
            "description": "Tempo limite da requisição",
            "headers": {
              "x-request-id": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "UUID correlation identifier used by this request."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Código estável, em inglês, documentado no guia de erros.",
            "example": "VALIDATION_ERROR"
          },
          "details": {
            "description": "Campos de diagnóstico específicos da operação."
          },
          "message": {
            "type": "string",
            "description": "Mensagem em pt-BR para quem lê; não é contrato.",
            "example": "Body JSON ausente ou invalido"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Envelope único de erro: `{ error: { code, message, details? } }`.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "LiveResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "MigrationStatus": {
        "type": "object",
        "required": [
          "applied",
          "expected"
        ],
        "properties": {
          "applied": {
            "type": "integer",
            "format": "int32",
            "description": "Migrações aplicadas no banco.",
            "example": 1,
            "minimum": 0
          },
          "expected": {
            "type": "integer",
            "format": "int32",
            "description": "Migrações embutidas no binário.",
            "example": 1,
            "minimum": 0
          }
        }
      },
      "ReadyResponse": {
        "type": "object",
        "required": [
          "status",
          "database",
          "migrations"
        ],
        "properties": {
          "database": {
            "type": "string",
            "example": "ok"
          },
          "migrations": {
            "$ref": "#/components/schemas/MigrationStatus"
          },
          "status": {
            "type": "string",
            "example": "ready"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "Health",
      "description": "Verificações públicas de vida e prontidão"
    },
    {
      "name": "Operations",
      "description": "Rotas operacionais públicas (OpenAPI e Swagger UI)"
    }
  ]
}
