APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
CONTAINER_NAME=engramind-api
# API_IMAGE=engramind-api:8000

DATABASE_PATH=/data/engramind.db
# Cache dos modelos locais de embedding (baixados no primeiro uso).
MODELS_PATH=/data/models
# Biblioteca do ONNX Runtime do provedor local de embeddings; a imagem já define.
# Fora do contêiner, sem ela, embedding.provider = local fica indisponível (a busca usa só o FTS).
# ORT_DYLIB_PATH=/usr/local/lib/libonnxruntime.so.1.31.1
READ_POOL_SIZE=4

# Aceito só com o banco sem tokens, para criar o primeiro token admin.
# Formato: eng.tk_<8 hex>.<segredo com 32+ caracteres [A-Za-z0-9_-]>
BOOTSTRAP_ADMIN_TOKEN=
# Pelo menos 32 caracteres: openssl rand -hex 32
TOKEN_PEPPER=
# Chave (base64, 32 bytes) que cifra os segredos de configuração: openssl rand -base64 32
SECRETS_KEY=

REQUEST_TIMEOUT_SECS=30
MAX_BODY_BYTES=1048576
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,engramind-api

ENGRAMIND_NETWORK=engramind-network
S3_NETWORK=minio-network

LITESTREAM_ENABLED=false
ENGRAMIND_S3_BUCKET=engramind
ENGRAMIND_S3_PATH=engramind
ENGRAMIND_S3_ENDPOINT=http://minio:9000
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

RUST_LOG=engramind=info,tower_http=warn
LOG_FORMAT=compact
LOG_ANSI=true
TZ=America/Sao_Paulo
